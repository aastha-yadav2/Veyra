# Veyra Backend Environment Configuration
# Copy this file to .env before starting the server.

# Server Port
PORT=3001

# Application Environment (development | production | test)
NODE_ENV=development

# Google Gemini API Key
# IMPORTANT: This secret must ONLY exist on the server runtime.
# NEVER commit .env or expose this key to Vite / client-side code.
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed CORS Origins (comma-separated if multiple)
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=30
