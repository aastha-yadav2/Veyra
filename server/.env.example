# ==============================================================================
# Veyra Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting local development.
# For Render deployment, configure these in the Render Dashboard > Environment.
#
# CRITICAL SECURITY NOTE:
# This file contains backend-only configuration.
# NEVER commit your active .env file or share your GEMINI_API_KEY.
# ==============================================================================

# Server Port (Render injects PORT automatically; defaults to 3001 locally)
PORT=3001

# Application Environment Mode (development | production | test)
NODE_ENV=production

# Google Gemini API Key
# REQUIRED: Google AI Studio API key for Gemini 1.5 Flash models.
# Kept strictly on the backend runtime. Never exposed to clients.
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Production Origin (Vercel deployment)
# REQUIRED IN PRODUCTION: Whitelists your deployed Vercel domain for CORS.
# Wildcards ('*') are strictly disallowed and rejected in production mode.
FRONTEND_URL=https://your-veyra-app.vercel.app

# Optional Additional CORS Origins (comma-separated if multiple, e.g. custom domain / preview)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate Limiting Configuration
# RATE_LIMIT_WINDOW_MS: Window duration in milliseconds (default: 15 minutes = 900000)
# RATE_LIMIT_MAX_REQUESTS: Max requests per IP in that window (default: 45)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=45
