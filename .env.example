# ==============================================================================
# Veyra Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local for local overrides.
# For Vercel production deployments, configure these under Project Settings > Environment Variables.
#
# CRITICAL SECURITY NOTE:
# NEVER expose GEMINI_API_KEY through VITE_ variables.
# The frontend communicates ONLY with the deployed backend API.
# All Gemini AI processing occurs strictly server-side.
# ==============================================================================

# Backend API Base URL
# - In local development: http://localhost:3001/api (or leave blank to use the safe default)
# - In production on Vercel: set to your deployed Render backend (e.g., https://veyra-api.onrender.com)
VITE_API_URL=https://your-veyra-api.onrender.com

# Mock Services Feature Flag
# - Set to 'false' in production so all requests hit the live backend API
# - Set to 'true' only if you want an entirely client-side offline mock mode
VITE_ENABLE_MOCK_SERVICES=false
