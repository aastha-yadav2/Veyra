# Veyra Environment Configuration Template
# Copy this file to .env or .env.local for local overrides.
# NOTE: Do NOT place LLM API keys or private database secrets in frontend environment files.
# All sensitive GenAI credentials belong in the backend service layer.

# Application Environment
VITE_APP_ENV=development

# Backend API Configuration
# Points to future backend server or local mock service
VITE_API_BASE_URL=http://localhost:3001/api/v1

# Feature Flags
VITE_ENABLE_MOCK_SERVICES=true
VITE_ANALYTICS_ENABLED=false
